*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
.venv-*/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Project data and generated artifacts
# Keep lightweight sample data under version control only when intentionally curated.
data/raw/
data/processed/
outputs/
models/
*.pkl
*.joblib
*.parquet

# ...but the permanent fold assignment IS the experiment record and must be
# version controlled: regenerating it would silently invalidate every past result.
!research/folds/*.parquet

# Local environment
.env
.env.*

# Wave-2: rebuilt artifacts, never committed (see REPRODUCIBILITY_MANIFEST.json)
cache/
logs/
research/oof/
*.npy
research/RESULTS.csv.lock

# built submission notebooks are artifacts: rebuild with research/scripts/build_submission.py
submissions/*.ipynb

# Crunch CLI project state. .crunchdao/token is an AUTH TOKEN -- never commit it.
# It also has to EXIST in the working tree: without it the CLI walks up the
# directory tree and, on this machine, finds a May-2025 project.json in $HOME
# for the *2025* `structural-break` competition. `crunch test` then silently
# runs against the wrong competition's data release and fails deep inside
# infer() with `could not convert string to float: 'value'`.
.crunchdao/
resources/
